# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# SAFETY: this repository sits at the root of a Windows user profile.
# Ignore everything by default and allow only the website's own files, so
# personal folders, SSH keys and app credentials can never be committed.
/*
!/.gitignore
!/.env.example
!/AGENTS.md
!/dangme_tts_qa_reports/
!/eslint.config.mjs
!/next.config.ts
!/package.json
!/public/
!/src/
!/tsconfig.json

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
