# The public address of the deployed site (used for SEO, sitemap and social cards).
NEXT_PUBLIC_SITE_URL=https://happycleaningservices.com

# Optional: paste the full Formspree endpoint when the complaints form is ready.
# Example: https://formspree.io/f/xxxxxxxx
# Until this is set, the complaints form falls back to opening the visitor's email app.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=


# Optional: AI assistant endpoint + key for the floating chat widget.
# Leave unset to use built-in helpful replies instead of an external AI API.
NEXT_PUBLIC_AI_API_ENDPOINT=
NEXT_PUBLIC_AI_API_KEY=
