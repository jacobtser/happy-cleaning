# The public address of the deployed site (used for SEO, sitemap and social cards).
# Update this when you connect a custom domain.
NEXT_PUBLIC_SITE_URL=https://happy-cleaning-ef17.vercel.app

# Optional: paste the full Formspree endpoint when the complaints form is ready.
# Example: https://formspree.io/f/xxxxxxxx
# Until this is set, the complaints form falls back to opening the visitor's email app.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=


# Optional AI provider keys for the floating assistant (server-side only).
# The /api/chat route tries Groq first, then DeepSeek, then OpenRouter.
# Leave unset to use the built-in helpful replies.
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
